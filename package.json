{
  "name": "@dotrino/identity",
  "version": "0.80.0",
  "description": "Identidad y rating de usuarios compartidos entre apps de Dotrino (vault iframe + postMessage)",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./node": {
      "import": "./src/node.js"
    },
    "./capabilities": {
      "import": "./vault/capabilities.js"
    },
    "./avatar": {
      "import": "./vault/avatar.js"
    },
    "./vault/core.js": "./vault/core.js",
    "./vault/remote.js": "./vault/remote.js",
    "./acta": {
      "import": "./vault/acta.js"
    },
    "./content": {
      "import": "./vault/content.js"
    },
    "./keyid": {
      "import": "./vault/keyid.js"
    }
  },
  "files": [
    "src",
    "vault",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "vendor": "node vendor.mjs",
    "test": "node --test \"test/*.test.js\" \"test/*.test.mjs\"",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "identity",
    "rating",
    "dotrino",
    "vault",
    "cross-origin"
  ],
  "author": "seyacat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imdotrino/dotrino-identity.git"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "typescript": "5.9.3",
    "@types/node": "^22.0.0"
  },
  "peerDependencies": {
    "@dotrino/proxy-client": ">=0.13.1"
  }
}
